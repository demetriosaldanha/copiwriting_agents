# Chaves usadas pelo backend AgentOS
OPENAI_API_KEY=
TAVILY_API_KEY=

# Obrigatória em produção: URL de conexão do PostgreSQL gerenciado.
# Exemplo: postgresql+psycopg://usuario:senha@host:5432/banco
DATABASE_URL=

# Desenvolvimento local opcional
AGENT_OS_HOST=0.0.0.0
AGENT_OS_RELOAD=true

# Usada pelo Streamlit. Em produção, informe a URL pública do backend AgentOS.
# AGENT_OS_URL=https://seu-backend.exemplo.com
